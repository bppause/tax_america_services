# Supabase backend storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public app URL used in emails and link generation. APP_BASE_URL is accepted
# as a legacy alias if PUBLIC_APP_URL isn't set.
PUBLIC_APP_URL=https://tax-america-services.onrender.com

# Bootstrap admin email — accepted as a fallback for GLOBAL_ADMIN_EMAILS so a
# fresh deployment can sign in its first global admin without a DB row.
BOOTSTRAP_ADMIN_EMAILS=your-email@gmail.com

# Email via Resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=Tax America Services <onboarding@resend.dev>
# Resend webhook signing secret (whsec_…) used to verify delivered / opened /
# clicked / bounced events. Configure the endpoint at
# https://<host>/api/m/tax/resend/webhook in the Resend dashboard and copy
# the signing secret shown there.
RESEND_WEBHOOK_SECRET=whsec_your_secret_here
# Resend Inbound webhook (customer replies → portal threads). Configure the
# inbound webhook at /api/m/tax/email/inbound in the Resend dashboard and
# copy the signing secret here. Leave blank to disable.
RESEND_INBOUND_SECRET=whsec_your_inbound_secret_here

# Anthropic — used to auto-translate task titles when one language is missing.
# Without this key the server falls back to leaving the missing language blank
# (no error, no crash). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Render
PORT=10000

# Global admin emails (comma-separated). Takes precedence over the
# app_users.role='global_admin' rows in Supabase, so these accounts always
# resolve to global admin regardless of DB state.
GLOBAL_ADMIN_EMAILS=youradmin@gmail.com

# Firebase web app config. Compiled into the frontend bundle at vite build
# time, so changes require a redeploy. Copy from Firebase Console → Project
# Settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
